{
  "name": "@pocketview/markdown",
  "version": "2.0.0",
  "description": "Markdown display plugin for pocketview, sanitized against XSS (markdown-it and DOMPurify).",
  "keywords": [
    "markdown",
    "pocketview",
    "plugin",
    "json",
    "viewer"
  ],
  "author": "David M. Rogers",
  "license": "Apache-2.0",
  "homepage": "https://frobnitzem.github.io/pocketview/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frobnitzem/pocketview.git",
    "directory": "packages/markdown"
  },
  "bugs": "https://github.com/frobnitzem/pocketview/issues",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/package-files.mjs --clean && tsc -p tsconfig.build.json && node ../../scripts/package-files.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@pocketview/core": "workspace:*",
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
