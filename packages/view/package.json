{
  "name": "@pocketview/view",
  "version": "2.0.0",
  "description": "Embeddable JSON and YAML viewer: publication-quality typesetting, an automatic layout that decides what to show, and navigation that never gets stuck.",
  "keywords": [
    "json",
    "yaml",
    "viewer",
    "json-viewer",
    "typesetting",
    "layout",
    "lcars",
    "embed"
  ],
  "author": "David M. Rogers",
  "license": "Apache-2.0",
  "homepage": "https://frobnitzem.github.io/pocketview/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frobnitzem/pocketview.git",
    "directory": "packages/view"
  },
  "bugs": "https://github.com/frobnitzem/pocketview/issues",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/pocketview.css"
  },
  "sideEffects": [
    "*.css",
    "./dist/index.js",
    "./src/index.ts"
  ],
  "files": [
    "dist",
    "src",
    "bundle",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./style.css": "./dist/pocketview.css"
    }
  },
  "scripts": {
    "build": "node ../../scripts/package-files.mjs --clean && tsc -p tsconfig.build.json && node ../../scripts/package-files.mjs pocketview.css",
    "bundle": "vite build",
    "prepack": "pnpm run build && pnpm run bundle",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fontsource/antonio": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@pocketview/core": "workspace:*",
    "@pocketview/markdown": "workspace:*",
    "@pocketview/typeset": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
